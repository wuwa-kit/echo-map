{
  "name": "echo-map",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "pnpm data:validate && pnpm typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm test && pnpm build",
    "data:sync": "node scripts/sync-all.ts",
    "data:sync:wiki": "node scripts/sync-wiki.ts",
    "data:sync:assets": "node scripts/sync-map-assets.ts",
    "data:sync:map": "node scripts/sync-map.ts",
    "data:validate": "node scripts/validate-data.ts",
    "data:check-assets": "node scripts/check-assets.ts",
    "data:convert-official": "node scripts/convert-official-points.ts"
  },
  "dependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/node": "catalog:",
    "@types/pngjs": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vueuse/core": "catalog:",
    "@vueuse/router": "catalog:",
    "fake-indexeddb": "catalog:",
    "immer": "catalog:",
    "ol": "catalog:",
    "pinia": "catalog:",
    "pngjs": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "vue": "catalog:",
    "vue-router": "catalog:",
    "vue-tsc": "catalog:",
    "zod": "catalog:"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.6.0",
      "onFail": "warn"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "11.24.0",
      "onFail": "error"
    }
  }
}
